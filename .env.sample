# =====================================================================
# .env.sample -- a TEMPLATE. Contains no real values and is safe to
# commit. Copy it to .env and fill it in for local development:
#
#     Windows PowerShell:  Copy-Item .env.sample .env
#     macOS / Linux:       cp .env.sample .env
#
# .env itself is in .gitignore and must stay there.
#
# ON RENDER YOU DO NOT UPLOAD A FILE. There is no .env on the server --
# you type these as Environment Variables in the Render dashboard
# instead, and only the handful marked [RENDER] below. See
# DEPLOYMENT.md step 5.
# =====================================================================

# ---------------- Flask ----------------
# [RENDER] Render generates this for you if you deploy from render.yaml;
# otherwise make one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app REFUSES to boot in production without it -- Flask signs the
# login session cookie with this key.
SECRET_KEY=change-me-to-a-long-random-string

# [RENDER] production on the live site, development on your machine.
FLASK_CONFIG=development
FLASK_APP=app.py

# ---------------- Database ----------------
# Local MySQL (XAMPP / Laragon / MySQL Workbench's local server).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dss_db

# [RENDER] One URL that overrides all five DB_* values above. This is
# what you paste from Aiven. Note "mysql+pymysql://" -- Aiven shows you
# "mysql://", and you must add the "+pymysql" yourself.
#   mysql+pymysql://avnadmin:PASSWORD@HOST-PORT.aivencloud.com:12345/defaultdb?charset=utf8mb4&ssl_ca=...
# DATABASE_URL=

# ---------------- The one live administrator ----------------
# [RENDER] On a production config seed.py creates NO demo accounts --
# their passwords are published in seed.py, which is in this repo. It
# creates this single administrator instead. Leave both unset locally.
# ADMIN_NAME=Administrator
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=

# ---------------- Google APIs ----------------
# Billable. Keep them on your machine; do NOT put them in Render.
GOOGLE_PLACES_API_KEY=
GOOGLE_GEOCODING_API_KEY=
GOOGLE_MAPS_JS_API_KEY=
PLACES_MAX_RESULTS=0

# [RENDER] false on the live site. A full city sweep is thousands of
# billable Google calls, and on a public URL the button that starts one
# is reachable by anyone who can log in. Do your fetching locally and
# move the rows across (DEPLOYMENT.md step 4).
PLACES_LIVE_FETCH=true

# ---------------- AI-written recommendations (optional) ----------------
# Leave off and the app uses its built-in rule-based text. Nothing
# breaks either way -- see app/services/recommendation_service.py.
USE_LLM_RECOMMENDATIONS=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ---------------- Email verification (optional) ----------------
# Unset means registration completes without a code.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_SENDER_NAME=MarketLens
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10

# ---------------- AI engine tuning ----------------
KMEANS_N_CLUSTERS=4
MSI_W1=0.45
MSI_W2=0.35
MSI_W3=0.20
SATURATION_ALERT_THRESHOLD=75.0
