# =====================================================================
# .env.sample -- a TEMPLATE. Contains no real values and is safe to
# commit. Copy it to .env and fill it in for local development:
#
#     Windows PowerShell:  Copy-Item .env.sample .env
#     macOS / Linux:       cp .env.sample .env
#
# .env itself is in .gitignore and must stay there.
#
# ON RENDER YOU DO NOT UPLOAD A FILE. There is no .env on the server --
# you type these as Environment Variables in the Render dashboard
# instead, and only the handful marked [RENDER] below. See
# DEPLOYMENT.md step 5.
# =====================================================================

# ---------------- Flask ----------------
# [RENDER] Render generates this for you if you deploy from render.yaml;
# otherwise make one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app REFUSES to boot in production without it -- Flask signs the
# login session cookie with this key.
SECRET_KEY=change-me-to-a-long-random-string

# [RENDER] production on the live site, development on your machine.
FLASK_CONFIG=development
FLASK_APP=app.py

# ---------------- Database ----------------
# Local MySQL (XAMPP / Laragon / MySQL Workbench's local server).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dss_db

# [RENDER] One URL that overrides all five DB_* values above. This is
# what you paste from Aiven. Note "mysql+pymysql://" -- Aiven shows you
# "mysql://", and you must add the "+pymysql" yourself.
#   mysql+pymysql://avnadmin:PASSWORD@HOST-PORT.aivencloud.com:12345/defaultdb?charset=utf8mb4&ssl_ca=...
# DATABASE_URL=

# ---------------- The one live administrator ----------------
# [RENDER] On a production config seed.py creates NO demo accounts --
# their passwords are published in seed.py, which is in this repo. It
# creates this single administrator instead. Leave both unset locally.
# ADMIN_NAME=Administrator
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=

# ---------------- Google APIs ----------------
# Billable. Keep them on your machine; do NOT put them in Render.
GOOGLE_PLACES_API_KEY=
GOOGLE_GEOCODING_API_KEY=
GOOGLE_MAPS_JS_API_KEY=
PLACES_MAX_RESULTS=0

# [RENDER] false on the live site. A full city sweep is thousands of
# billable Google calls, and on a public URL the button that starts one
# is reachable by anyone who can log in. Do your fetching locally and
# move the rows across (DEPLOYMENT.md step 4).
PLACES_LIVE_FETCH=true

# ---------------- AI-written recommendations (optional) ----------------
# Leave off and the app uses its built-in rule-based text. Nothing
# breaks either way -- see app/services/recommendation_service.py.
USE_LLM_RECOMMENDATIONS=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ---------------- Sending over HTTPS instead of SMTP ----------------
# READ THIS IF CODES ARE NOT ARRIVING ON A FREE HOST.
#
# Render blocks outbound traffic to SMTP ports 25, 465 and 587 on FREE
# web services (since 26 September 2026). The connection never leaves
# the host, so no app password or retry gets a message out.
#
# Set BREVO_API_KEY and email goes over HTTPS on port 443 instead,
# which is not blocked. Free tier is 300 emails/day; sign up at
# brevo.com, create an API key under SMTP & API, and VERIFY THE SENDING
# ADDRESS under Senders, Domains & Dedicated IPs -- an unverified
# sender is refused, and that is the one failure that looks like a code
# problem and is not.
#
# Leave it blank and Gmail SMTP is used exactly as before, so local
# development and any paid host need no change at all.
BREVO_API_KEY=

# Who the mail comes from. Defaults to GMAIL_ADDRESS. Set it when the
# address you verified with Brevo is a different one.
MAIL_FROM_ADDRESS=

# How long a password-reset code lasts. Longer than the sign-up code
# because resetting often means finding another device to read the
# email on.
PASSWORD_RESET_CODE_TTL_MINUTES=15

# ---------------- Email OTP verification (optional) ----------------
# Unset means registration completes with no code. Set both and every
# new sign-up must enter a 6-digit code emailed to the address they
# registered with.
#
# GMAIL_APP_PASSWORD is a 16-character Google APP PASSWORD, not the
# account's normal password -- create one at
# myaccount.google.com/apppasswords (2-Step Verification must be on).
# PASTE IT WITH THE SPACES REMOVED: Google shows it as four groups of
# four, smtplib does not reliably accept them, and the resulting 535
# looks exactly like a wrong password.
#
# To check it without registering throwaway accounts: signed in as an
# Admin, /admin/email-status shows the configuration and the last
# failure, and /admin/email-status/probe authenticates against Gmail
# for real (nothing is sent). Neither ever prints the password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_SENDER_NAME=MarketLens
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10

# Wrong codes before the pending registration is cancelled. A 6-digit
# code is one chance in a million per guess, which only protects
# anything if the number of guesses is bounded.
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Minimum seconds between "resend code" requests. A free Gmail account
# sends roughly 500 messages a day, and the recipient is whoever filled
# in the registration form.
EMAIL_VERIFICATION_RESEND_SECONDS=60

# true  = a failed send blocks the sign-up and says so.
# false = fall back to creating the account without verification.
# Defaults to TRUE whenever Gmail is configured above, because
# configuring it is the act of saying you want verification. Left blank
# here so that default applies.
REQUIRE_EMAIL_VERIFICATION=

# ---------------- AI engine tuning ----------------
KMEANS_N_CLUSTERS=4
MSI_W1=0.45
MSI_W2=0.35
MSI_W3=0.20
SATURATION_ALERT_THRESHOLD=75.0
